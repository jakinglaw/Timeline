<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Case Timeline</title>
<meta name="viewport" content="width=device-width, initial-scale=1">
<script src="https://docs.getgrist.com/grist-plugin-api.js"></script>
<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --bg:        #ffffff;
    --bg2:       #f7f6f2;
    --bg3:       #f0efe9;
    --text:      #1a1a18;
    --text2:     #5f5e5a;
    --text3:     #999890;
    --border:    rgba(0,0,0,0.10);
    --border2:   rgba(0,0,0,0.18);
    --radius:    8px;
    --radius-lg: 12px;
    --track:     #d3d1c7;
    --font:      'DM Sans', system-ui, sans-serif;
    --font-mono: 'DM Mono', monospace;
  }

  @media (prefers-color-scheme: dark) {
    :root {
      --bg:      #1e1e1c;
      --bg2:     #282825;
      --bg3:     #323230;
      --text:    #f0efe9;
      --text2:   #b4b2a9;
      --text3:   #6e6d68;
      --border:  rgba(255,255,255,0.10);
      --border2: rgba(255,255,255,0.18);
      --track:   #3d3d3a;
    }
  }

  @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500&family=DM+Mono:wght@400;500&display=swap');

  html, body {
    font-family: var(--font);
    background: var(--bg);
    color: var(--text);
    font-size: 14px;
    line-height: 1.5;
    min-height: 100vh;
  }

  /* ── TOOLBAR ─────────────────────────────────────────────── */
  .toolbar {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
    padding: 10px 16px;
    border-bottom: 0.5px solid var(--border);
    background: var(--bg2);
    position: sticky;
    top: 0;
    z-index: 20;
  }
  .toolbar-section {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .toolbar label {
    font-size: 11px;
    color: var(--text3);
    font-weight: 500;
    white-space: nowrap;
  }
  .toolbar input[type="date"] {
    font-family: var(--font-mono);
    font-size: 12px;
    padding: 4px 8px;
    border: 0.5px solid var(--border2);
    border-radius: var(--radius);
    background: var(--bg);
    color: var(--text);
    height: 30px;
    width: 138px;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-family: var(--font);
    font-size: 12px;
    font-weight: 500;
    height: 30px;
    padding: 0 12px;
    border: 0.5px solid var(--border2);
    border-radius: var(--radius);
    background: var(--bg);
    color: var(--text2);
    cursor: pointer;
    white-space: nowrap;
    transition: background 0.12s;
  }
  .btn:hover { background: var(--bg3); }
  .btn svg { flex-shrink: 0; }

  .sep {
    width: 0.5px;
    height: 20px;
    background: var(--border2);
    margin: 0 2px;
  }

  /* ── STATUS BAR ──────────────────────────────────────────── */
  .statusbar {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
    padding: 6px 16px;
    border-bottom: 0.5px solid var(--border);
    background: var(--bg);
    min-height: 34px;
  }
  .pill {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 11px;
    font-weight: 500;
    padding: 3px 9px;
    border-radius: 20px;
    border: 0.5px solid transparent;
    cursor: pointer;
    transition: opacity 0.12s;
    user-select: none;
  }
  .pill.off { opacity: 0.35; }
  .pill-dot {
    width: 8px; height: 8px;
    border-radius: 50%;
    flex-shrink: 0;
  }
  .count-badge {
    font-family: var(--font-mono);
    font-size: 10px;
    background: var(--bg3);
    color: var(--text3);
    padding: 1px 5px;
    border-radius: 10px;
    margin-left: 2px;
  }

  /* ── MAIN SCROLL AREA ────────────────────────────────────── */
  .tl-scroll-wrap {
    overflow-x: auto;
    overflow-y: visible;
    padding: 0 16px 24px;
    position: relative;
  }
  .tl-canvas {
    position: relative;
    min-width: 100%;
  }

  /* axis row */
  .axis-row {
    display: flex;
    justify-content: space-between;
    padding: 10px 0 4px;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--text3);
    min-height: 28px;
  }
  .axis-tick {
    position: absolute;
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--text3);
    transform: translateX(-50%);
    white-space: nowrap;
  }

  /* track */
  .track-row {
    position: relative;
    height: 2px;
    background: var(--track);
    margin: 0;
  }
  .track-today {
    position: absolute;
    top: -6px;
    width: 2px;
    height: 14px;
    background: #E24B4A;
    border-radius: 1px;
  }
  .track-today-label {
    position: absolute;
    top: -20px;
    font-size: 10px;
    color: #A32D2D;
    font-weight: 500;
    transform: translateX(-50%);
    white-space: nowrap;
  }

  /* events layer */
  .events-layer {
    position: relative;
    height: 220px;
  }
  .evt-node {
    position: absolute;
    display: flex;
    flex-direction: column;
    align-items: center;
    transform: translateX(-50%);
    top: 0;
    cursor: pointer;
  }
  .evt-date-label {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--text3);
    white-space: nowrap;
    margin-bottom: 3px;
    margin-top: 4px;
  }
  .evt-cat-pill {
    font-size: 10px;
    font-weight: 500;
    padding: 2px 7px;
    border-radius: 10px;
    white-space: nowrap;
    margin-bottom: 0;
  }
  .evt-stem {
    width: 1.5px;
    height: 36px;
    flex-shrink: 0;
  }
  .evt-dot {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    border: 2px solid var(--bg);
    flex-shrink: 0;
    position: relative;
    z-index: 3;
    transition: transform 0.12s;
  }
  .evt-node:hover .evt-dot { transform: scale(1.35); }
  .evt-desc-card {
    margin-top: 8px;
    width: 140px;
    font-size: 11px;
    line-height: 1.45;
    text-align: center;
    color: var(--text2);
    background: var(--bg2);
    border: 0.5px solid var(--border);
    border-radius: var(--radius);
    padding: 5px 7px;
    word-break: break-word;
  }

  /* ── TOOLTIP ─────────────────────────────────────────────── */
  #tooltip {
    position: fixed;
    z-index: 9999;
    background: var(--bg);
    border: 0.5px solid var(--border2);
    border-radius: var(--radius-lg);
    padding: 10px 14px;
    max-width: 280px;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.12s;
    font-size: 13px;
    line-height: 1.55;
  }
  .tt-date { font-family: var(--font-mono); font-size: 11px; color: var(--text3); margin-bottom: 2px; }
  .tt-cat  { font-size: 11px; font-weight: 500; margin-bottom: 5px; }
  .tt-desc { color: var(--text); font-size: 13px; }

  /* ── EMPTY / CONFIG STATES ───────────────────────────────── */
  .state-panel {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 3rem 1rem;
    color: var(--text3);
    text-align: center;
  }
  .state-panel svg { opacity: 0.4; }
  .state-panel p { font-size: 13px; line-height: 1.6; max-width: 340px; }
  .state-panel code {
    font-family: var(--font-mono);
    background: var(--bg3);
    padding: 1px 5px;
    border-radius: 4px;
    font-size: 12px;
    color: var(--text2);
  }

  /* ── CONFIG BANNER ───────────────────────────────────────── */
  .config-banner {
    margin: 10px 16px;
    padding: 10px 14px;
    background: var(--bg2);
    border: 0.5px solid var(--border2);
    border-radius: var(--radius);
    font-size: 12px;
    color: var(--text2);
    line-height: 1.6;
  }
  .config-banner strong { font-weight: 500; color: var(--text); }

  /* ── RECORD COUNT ────────────────────────────────────────── */
  .record-count {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--text3);
    margin-left: auto;
    white-space: nowrap;
  }
</style>
</head>
<body>

<h2 class="sr-only" style="position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0)">
  Case event timeline — displays case events from the linked Grist table on a horizontally scrollable track, color-coded by category.
</h2>

<!-- ── TOOLBAR ── -->
<div class="toolbar" id="toolbar">
  <div class="toolbar-section">
    <label>Start</label>
    <input type="date" id="rangeStart" title="Timeline start date">
  </div>
  <div class="toolbar-section">
    <label>End</label>
    <input type="date" id="rangeEnd" title="Timeline end date">
  </div>
  <button class="btn" onclick="applyRange()" title="Apply date range">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
    Apply range
  </button>
  <button class="btn" onclick="fitToEvents()" title="Fit to events">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 3 21 3 21 9"/><polyline points="9 21 3 21 3 15"/><line x1="21" y1="3" x2="14" y2="10"/><line x1="3" y1="21" x2="10" y2="14"/></svg>
    Fit to data
  </button>
  <div class="sep"></div>
  <button class="btn" id="todayBtn" onclick="toggleToday()" title="Show today marker">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
    Today
  </button>
  <span class="record-count" id="recordCount"></span>
</div>

<!-- ── CATEGORY FILTER BAR ── -->
<div class="statusbar" id="statusbar"></div>

<!-- ── CONFIG BANNER (shown when columns need mapping) ── -->
<div class="config-banner" id="configBanner" style="display:none">
  <strong>Column mapping needed.</strong> Open the Creator Panel → Widget Options and map:
  <code>EventDate</code>, <code>Category</code>, <code>Description</code>.
  Optionally map <code>CaseID</code> to filter by case.
</div>

<!-- ── TIMELINE AREA ── -->
<div id="mainArea">
  <div class="state-panel" id="emptyPanel">
    <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/>
      <circle cx="7" cy="12" r="2" fill="currentColor"/><circle cx="14" cy="6" r="2" fill="currentColor"/><circle cx="18" cy="18" r="2" fill="currentColor"/>
    </svg>
    <p>Waiting for data from Grist.<br>Link this widget to a table with your case events.</p>
  </div>
  <div id="timelineWrap" style="display:none">
    <div class="tl-scroll-wrap" id="tlScrollWrap">
      <div class="tl-canvas" id="tlCanvas"></div>
    </div>
  </div>
</div>

<div id="tooltip"></div>

<script>
/* ── CATEGORY COLOR MAP ────────────────────────────────────── */
const CAT_COLORS = {
  Filing:        { dot: '#185FA5', badge: '#ddeef9', text: '#0C447C' },
  Hearing:       { dot: '#3B6D11', badge: '#e2f0d1', text: '#27500A' },
  Discovery:     { dot: '#854F0B', badge: '#fce8c8', text: '#633806' },
  Order:         { dot: '#993556', badge: '#f7dce8', text: '#72243E' },
  Communication: { dot: '#534AB7', badge: '#e7e6fb', text: '#3C3489' },
  Deadline:      { dot: '#A32D2D', badge: '#fce0e0', text: '#791F1F' },
  Deposition:    { dot: '#0F6E56', badge: '#d5f0e8', text: '#085041' },
  Motion:        { dot: '#BA7517', badge: '#faecd8', text: '#854F0B' },
  Settlement:    { dot: '#1D9E75', badge: '#d5f0e8', text: '#0F6E56' },
  Other:         { dot: '#5F5E5A', badge: '#ebebeb', text: '#2C2C2A' },
};
function getCatColor(cat) {
  return CAT_COLORS[cat] || CAT_COLORS.Other;
}

/* ── STATE ─────────────────────────────────────────────────── */
let allEvents    = [];
let filterCats   = new Set();
let rangeStart   = null;
let rangeEnd     = null;
let showToday    = true;
let mappings     = null;
let columnsReady = false;

/* ── GRIST INTEGRATION ─────────────────────────────────────── */
grist.ready({
  requiredAccess: 'read table',
  columns: [
    { name: 'EventDate',    title: 'Event Date',   type: 'Date,DateTime,Text', allowMultiple: false },
    { name: 'Category',     title: 'Category',     type: 'Text,Choice',        allowMultiple: false },
    { name: 'Description',  title: 'Description',  type: 'Text',               allowMultiple: false },
    { name: 'CaseID',       title: 'Case ID',      type: 'Text,Numeric,Reference', allowMultiple: false, optional: true },
  ],
  onEditOptions() {
    /* no-op: Grist will open creator panel */
  }
});

grist.onRecords(function(records, maps) {
  mappings = maps;
  columnsReady = !!(maps && maps.EventDate && maps.Category && maps.Description);
  document.getElementById('configBanner').style.display = columnsReady ? 'none' : '';

  if (!columnsReady) {
    allEvents = [];
    render();
    return;
  }

  allEvents = records
    .map(r => {
      const mapped = grist.mapColumnNames(r, maps);
      if (!mapped) return null;
      const rawDate = mapped.EventDate;
      const dateStr = parseGristDate(rawDate);
      if (!dateStr) return null;
      return {
        id:          r.id,
        date:        dateStr,
        cat:         String(mapped.Category || 'Other').trim(),
        desc:        String(mapped.Description || '').trim(),
        caseId:      mapped.CaseID != null ? String(mapped.CaseID) : null,
      };
    })
    .filter(Boolean)
    .sort((a, b) => a.date.localeCompare(b.date));

  /* Rebuild category filter set: keep existing selections, add new cats */
  const newCats = new Set(allEvents.map(e => e.cat));
  newCats.forEach(c => { if (!filterCats.has(c)) filterCats.add(c); });
  /* Remove cats that no longer exist */
  [...filterCats].forEach(c => { if (!newCats.has(c)) filterCats.delete(c); });

  document.getElementById('recordCount').textContent =
    allEvents.length + ' event' + (allEvents.length !== 1 ? 's' : '');

  render();
});

/* ── DATE PARSING ──────────────────────────────────────────── */
function parseGristDate(raw) {
  if (!raw) return null;
  /* Grist Date columns come as Unix timestamp (seconds) */
  if (typeof raw === 'number') {
    const d = new Date(raw * 1000);
    if (isNaN(d)) return null;
    return toYMD(d);
  }
  /* ISO string */
  if (typeof raw === 'string') {
    const m = raw.match(/^(\d{4}-\d{2}-\d{2})/);
    if (m) return m[1];
    /* MM/DD/YYYY */
    const m2 = raw.match(/^(\d{1,2})\/(\d{1,2})\/(\d{4})/);
    if (m2) return `${m2[3]}-${m2[1].padStart(2,'0')}-${m2[2].padStart(2,'0')}`;
  }
  return null;
}

/* ── HELPERS ───────────────────────────────────────────────── */
function dateFromYMD(s) { return s ? new Date(s + 'T00:00:00') : null; }
function toYMD(d) { return d.toISOString().slice(0, 10); }
function fmtShort(s) {
  const d = dateFromYMD(s);
  return d ? d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : '';
}
function fmtAxis(d) {
  return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: '2-digit' });
}
function daysBetween(a, b) { return Math.round((b - a) / 86400000); }
const TODAY_YMD = toYMD(new Date());

/* ── TOOLBAR ACTIONS ───────────────────────────────────────── */
function applyRange() {
  const s = document.getElementById('rangeStart').value;
  const e = document.getElementById('rangeEnd').value;
  rangeStart = s ? dateFromYMD(s) : null;
  rangeEnd   = e ? dateFromYMD(e) : null;
  render();
}
function fitToEvents() {
  rangeStart = null; rangeEnd = null;
  document.getElementById('rangeStart').value = '';
  document.getElementById('rangeEnd').value   = '';
  render();
}
function toggleToday() {
  showToday = !showToday;
  document.getElementById('todayBtn').style.opacity = showToday ? '1' : '0.4';
  render();
}

/* ── CATEGORY PILL TOGGLE ──────────────────────────────────── */
function toggleCat(cat) {
  if (filterCats.has(cat)) filterCats.delete(cat);
  else filterCats.add(cat);
  renderStatusBar();
  renderTimeline();
}

/* ── MAIN RENDER ───────────────────────────────────────────── */
function render() {
  renderStatusBar();
  if (allEvents.length === 0) {
    document.getElementById('emptyPanel').style.display    = '';
    document.getElementById('timelineWrap').style.display  = 'none';
    return;
  }
  document.getElementById('emptyPanel').style.display    = 'none';
  document.getElementById('timelineWrap').style.display  = '';
  renderTimeline();
}

function renderStatusBar() {
  const bar  = document.getElementById('statusbar');
  bar.innerHTML = '';
  const cats = [...new Set(allEvents.map(e => e.cat))].sort();
  cats.forEach(cat => {
    const col   = getCatColor(cat);
    const count = allEvents.filter(e => e.cat === cat).length;
    const on    = filterCats.has(cat);
    const pill  = document.createElement('div');
    pill.className = 'pill' + (on ? '' : ' off');
    pill.style.background   = on ? col.badge : 'transparent';
    pill.style.color        = col.text;
    pill.style.borderColor  = on ? col.dot : 'var(--border)';
    pill.innerHTML =
      `<span class="pill-dot" style="background:${col.dot}"></span>` +
      `<span>${cat}</span>` +
      `<span class="count-badge">${count}</span>`;
    pill.addEventListener('click', () => toggleCat(cat));
    pill.title = on ? `Hide ${cat}` : `Show ${cat}`;
    bar.appendChild(pill);
  });
}

/* ── TIMELINE RENDER ───────────────────────────────────────── */
function renderTimeline() {
  const canvas = document.getElementById('tlCanvas');
  const visible = allEvents.filter(e => filterCats.has(e.cat));

  if (visible.length === 0) {
    canvas.innerHTML = '<div style="padding:2rem 0;text-align:center;color:var(--text3);font-size:13px">No events match the current filter.</div>';
    return;
  }

  const dates  = visible.map(e => dateFromYMD(e.date));
  const minD   = rangeStart || new Date(Math.min(...dates));
  const maxD   = rangeEnd   || new Date(Math.max(...dates));
  const totalDays = Math.max(daysBetween(minD, maxD), 1);

  /* Padding: ~4% of span, min 3 days */
  const padDays = Math.max(Math.ceil(totalDays * 0.04), 3);
  const startD  = new Date(minD); startD.setDate(startD.getDate() - padDays);
  const endD    = new Date(maxD); endD.setDate(endD.getDate()   + padDays);
  const spanDays = daysBetween(startD, endD);

  /* px per day — aim for enough spread, minimum 4px/day */
  const containerW = document.getElementById('tlScrollWrap').clientWidth || 800;
  const pxPerDay   = Math.max(4, (containerW - 32) / spanDays);
  const totalW     = Math.round(spanDays * pxPerDay);

  canvas.innerHTML = '';
  canvas.style.width = Math.max(totalW, containerW - 32) + 'px';

  /* ── Axis ticks ── */
  const axisRow = document.createElement('div');
  axisRow.style.cssText = 'position:relative;height:28px;';
  const numTicks = Math.min(12, Math.ceil(spanDays / 7));
  for (let i = 0; i <= numTicks; i++) {
    const frac = i / numTicks;
    const tickDate = new Date(startD.getTime() + frac * spanDays * 86400000);
    const tick = document.createElement('span');
    tick.className = 'axis-tick';
    tick.style.left = Math.round(frac * totalW) + 'px';
    tick.style.top  = '8px';
    tick.textContent = fmtAxis(tickDate);
    axisRow.appendChild(tick);
  }
  canvas.appendChild(axisRow);

  /* ── Track bar ── */
  const trackRow = document.createElement('div');
  trackRow.className = 'track-row';

  /* Today marker */
  if (showToday) {
    const todayD = dateFromYMD(TODAY_YMD);
    if (todayD >= startD && todayD <= endD) {
      const todayOff = Math.round(daysBetween(startD, todayD) * pxPerDay);
      const tm = document.createElement('div');
      tm.className = 'track-today';
      tm.style.left = todayOff + 'px';
      const tl = document.createElement('span');
      tl.className = 'track-today-label';
      tl.style.left = todayOff + 'px';
      tl.textContent = 'Today';
      trackRow.appendChild(tl);
      trackRow.appendChild(tm);
    }
  }
  canvas.appendChild(trackRow);

  /* ── Events ── */
  const evtsLayer = document.createElement('div');
  evtsLayer.className = 'events-layer';

  /* Cluster detection: group events within ~80px of each other */
  const positioned = visible.map(evt => ({
    evt,
    px: Math.round(daysBetween(startD, dateFromYMD(evt.date)) * pxPerDay),
  }));

  /* Stagger overlapping events */
  const STAGGER = 18;
  positioned.forEach((item, i) => {
    const col  = getCatColor(item.evt.cat);
    const node = document.createElement('div');
    node.className = 'evt-node';
    node.style.left = item.px + 'px';

    /* Check for nearby predecessors to offset vertically */
    const overlap = positioned.slice(0, i).filter(p => Math.abs(p.px - item.px) < 72);
    const topOff  = overlap.length * STAGGER;
    node.style.paddingTop = topOff + 'px';

    const dateLabel = document.createElement('div');
    dateLabel.className = 'evt-date-label';
    dateLabel.textContent = fmtShort(item.evt.date);

    const catPill = document.createElement('span');
    catPill.className = 'evt-cat-pill';
    catPill.style.background = col.badge;
    catPill.style.color      = col.text;
    catPill.textContent = item.evt.cat;

    const stem = document.createElement('div');
    stem.className = 'evt-stem';
    stem.style.background = col.dot;

    const dot = document.createElement('div');
    dot.className = 'evt-dot';
    dot.style.background = col.dot;

    const desc = document.createElement('div');
    desc.className = 'evt-desc-card';
    const short = item.evt.desc.length > 90 ? item.evt.desc.slice(0, 87) + '…' : item.evt.desc;
    desc.textContent = short;

    node.appendChild(dateLabel);
    node.appendChild(catPill);
    node.appendChild(stem);
    node.appendChild(dot);
    node.appendChild(desc);

    node.addEventListener('mouseenter', e => showTip(e, item.evt));
    node.addEventListener('mouseleave', hideTip);

    evtsLayer.appendChild(node);
  });

  canvas.appendChild(evtsLayer);
}

/* ── TOOLTIP ───────────────────────────────────────────────── */
const tipEl = document.getElementById('tooltip');
function showTip(e, evt) {
  const col = getCatColor(evt.cat);
  tipEl.innerHTML =
    `<div class="tt-date">${fmtShort(evt.date)}</div>` +
    `<div class="tt-cat" style="color:${col.dot}">${evt.cat}` +
      (evt.caseId ? ` &nbsp;·&nbsp; <span style="opacity:.6;font-weight:400">Case ${evt.caseId}</span>` : '') +
    `</div>` +
    `<div class="tt-desc">${evt.desc}</div>`;
  tipEl.style.opacity = '1';
  moveTooltip(e);
  document.addEventListener('mousemove', moveTooltip);
}
function moveTooltip(e) {
  tipEl.style.left = (e.clientX + 14) + 'px';
  tipEl.style.top  = (e.clientY - 12) + 'px';
}
function hideTip() {
  tipEl.style.opacity = '0';
  document.removeEventListener('mousemove', moveTooltip);
}

/* ── RESIZE HANDLER ────────────────────────────────────────── */
let resizeTimer;
window.addEventListener('resize', () => {
  clearTimeout(resizeTimer);
  resizeTimer = setTimeout(() => { if (allEvents.length) renderTimeline(); }, 150);
});
</script>
